# Local studio: no external services or API keys required.
PORT=3000
HOST=127.0.0.1
MOTHLIGHT_DATA_DIR=.mothlight
# Hosted mode requires secure cookies over HTTPS, disables first-user setup,
# and expects accounts to be provisioned with the admin CLI.
# MOTHLIGHT_HOSTED=true
# MOTHLIGHT_ORIGIN=https://studio.example.com
# Still-image APIs (dedicated provider API billing; ChatGPT/Gemini subscriptions do not cover these).\n# Configure the keys you intend to use, then restart the server. Never put keys in browser code.\nOPENAI_API_KEY=\nGEMINI_API_KEY=\n\n# Optional local image/video adapter; runs as a server process.
# MOTHLIGHT_GENERATOR=/absolute/path/to/adapter

# BytePlus ModelArk: copy your API key here in .env (never commit it).
# Restart bun run dev after saving .env.
BYTEPLUS_MODELARK_API_KEY=
# Optional: restrict the dropdown to supported model IDs activated in your account.
# MOTHLIGHT_SEEDANCE_MODELS=dreamina-seedance-2-5-260628,dreamina-seedance-2-0-fast-260128
