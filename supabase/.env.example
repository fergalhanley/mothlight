# Copy to supabase/.env (git-ignored) ONLY if you want to exercise the third-party
# providers against the LOCAL stack. `supabase start` works fine without this file,
# because every [auth.external.*] block in config.toml ships disabled.
#
# For the HOSTED project these values go in the Supabase dashboard instead — see the
# "Manual provider setup" checklist in the root README.

# Google — OAuth 2.0 Web application client (Google Cloud Console → Credentials)
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Facebook / Meta — App ID and App Secret (Meta for Developers → App settings → Basic)
SUPABASE_AUTH_EXTERNAL_FACEBOOK_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_FACEBOOK_SECRET=

# Apple — Services ID as the client id, and the generated client secret JWT
# (Apple Developer → Certificates, Identifiers & Profiles)
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=
