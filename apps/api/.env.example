# Copy to .env and fill in. Never commit .env.
# Local values come from `supabase start` (see README).

# Port the Hono server listens on.
PORT=3001

# Base URL of your Supabase project.
# Local: http://127.0.0.1:54321   Hosted: https://<project-ref>.supabase.co
SUPABASE_URL=http://127.0.0.1:54321

# Service-role key. Bypasses RLS — server-side only, never expose to clients.
SUPABASE_SERVICE_ROLE_KEY=

# Legacy HS256 symmetric JWT secret (Supabase Dashboard → Settings → API → JWT Secret).
# Leave EMPTY to verify tokens against the project's JWKS endpoint instead, which is
# the default for projects using asymmetric (ES256/RS256) signing keys.
SUPABASE_JWT_SECRET=

# Comma-separated list of origins allowed to call this API from a browser.
CORS_ALLOWED_ORIGINS=http://localhost:3000
