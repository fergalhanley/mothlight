# Copy to .env and fill in. Never commit .env.

# Port the render service listens on.
PORT=3002

# Public origin the PHONE will use to download finished videos. On a local network this
# must be your machine's LAN IP, not localhost — the device cannot reach your loopback.
PUBLIC_BASE_URL=http://localhost:3002

# Scratch space for uploads and rendered output. In a container, mount a volume here:
# renders are tens of megabytes and the sweeper only reclaims them after an hour.
WORKSPACE_DIR=/tmp/mothlight-render

# Comma-separated allowed origins, or * for any. The mobile app is not a browser and
# sends no Origin header, so this only matters if a web client is added later.
CORS_ALLOWED_ORIGINS=*
