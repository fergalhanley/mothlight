# Copy to .env and fill in. Never commit .env.
#
# EXPO_PUBLIC_* variables are inlined into the JS bundle at build time and are therefore
# readable by anyone with the app. Only ever put public values here — never a
# service-role key.

# --- Rendering (§7) ---------------------------------------------------------------------
# Base URL of the render service (apps/render). Without it, everything in the app works
# except "Render video", which reports that rendering isn't configured on this build.
#
# Local (Android emulator):  http://10.0.2.2:3002
# Local (iOS simulator):     http://localhost:3002
# Local (physical device):   http://<your-LAN-ip>:3002
# Deployed:                  https://<your-fly-or-railway-host>
#
# Note the render service's own PUBLIC_BASE_URL must also be reachable by the phone —
# it is what the download URL is built from.
EXPO_PUBLIC_RENDER_API_URL=

# --- Dormant Supabase auth --------------------------------------------------------------
# v0 NEEDS NONE OF THIS. The app has no accounts: projects live only on the device.
# These exist for the dormant wiring under src/lib/auth/ — read the README there first.

# Base URL of your Supabase project.
# Local (Android emulator): http://10.0.2.2:54321   Hosted: https://<ref>.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# Anon / publishable key. Safe to ship — it is governed by RLS.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
