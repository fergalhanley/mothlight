# Copy to .env and fill in. Never commit .env.
#
# v0 NEEDS NONE OF THIS. The app has no accounts and no backend: projects live only on
# the device. Everything below is for the dormant Supabase auth wiring under
# src/lib/auth/ — see the README there before setting any of it.
#
# EXPO_PUBLIC_* variables are inlined into the JS bundle at build time and are therefore
# readable by anyone with the app. Only ever put public values here — never a
# service-role key.

# Base URL of your Supabase project.
# Local (iOS simulator / web): http://127.0.0.1:54321
# Local (Android emulator):    http://10.0.2.2:54321
# Local (physical device):     http://<your-LAN-ip>:54321
# Hosted:                      https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# Anon / publishable key. Safe to ship — it is governed by RLS.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
